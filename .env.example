NEXT_PUBLIC_BASE_URL=http://localhost:3000

# The Plug must use its own dedicated Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-side Firebase Admin service account JSON for Vercel.
FIREBASE_ADMIN_KEY=

# UploadThing token for sourcing-request image/PDF attachments.
UPLOADTHING_TOKEN=

# Shared operations entry gate (current implementation; migrate to individual identities deliberately).
THE_PLUG_OPERATIONS_WORD=

# Legacy name still consumed by the scheduled reminder workflow and API route.
# Rename the workflow, route, GitHub secret and Vercel environment together when intentionally migrating it.
BOEMO_REMINDER_CRON_SECRET=

# GitHub Actions Firebase rules deployment target (separate from Vercel FIREBASE_ADMIN_KEY).
FIREBASE_PROJECT_ID=
